# Copy to .env and fill in the keys for the providers you use.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: timezone for cron schedules if not set in config.yaml
TZ=Europe/Warsaw

